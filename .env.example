# ==============================================================================
# Authentication & Webmaster
# ==============================================================================
BETTER_AUTH_SECRET=generate-a-random-32-character-secret-key-here
BETTER_AUTH_URL=http://localhost:3000
WEBMASTER_EMAIL=abir4dev@gmail.com
NEXT_PUBLIC_CURRENT_YEAR=2026

# ==============================================================================
# Cloudflare D1 Database (REST API)
# ==============================================================================
# Found in Cloudflare Dashboard URL: https://dash.cloudflare.com/<ACCOUNT_ID>
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# Found under Workers & Pages > D1 > ieeebracu-db
CLOUDFLARE_D1_DATABASE_ID=ee26fed4-2154-427c-b890-74d09c73f3d1
# Cloudflare API Token with "D1:Edit" permissions
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ==============================================================================
# Cloudflare R2 Object Storage (S3 API)
# ==============================================================================
# Create R2 API Tokens under Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ieeebracu-media

# (Optional) If you have a custom domain or public bucket enabled on R2:
# e.g., https://media.ieeebracu.com or https://pub-xxxxxx.r2.dev
# If left empty, images are proxied through /api/media/[...key]
R2_PUBLIC_URL=
